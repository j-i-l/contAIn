# Podman Quadlet — contain
# This is a TEMPLATE. setup.sh renders it with concrete values into
# /etc/containers/systemd/contain.container
#
# Placeholders (sed/awk-replaced by setup.sh):
#   VOLUME_LINES, PRIMARY_HOME, CONTAINERD_CONFIG, HOST, PORT (public),
#   LISTEN_PORT (port OpenCode binds), LIFECYCLE_UNIT_LINES
#   (StopWhenUnneeded in on-demand mode), LIFECYCLE_CONTAINER_LINES
#   (PodmanArgs=--sdnotify=healthy in on-demand mode), INSTALL_SECTION
#   ([Install] block in always-on mode, empty in on-demand mode)

[Unit]
Description=contain — Sandboxed AI Agent Container
After=network-online.target
@@LIFECYCLE_UNIT_LINES@@

[Container]
ContainerName=contain
Image=localhost/contain:latest
@@LIFECYCLE_CONTAINER_LINES@@
# Define health at container creation rather than in image metadata. Podman
# drops Containerfile HEALTHCHECK from OCI images, while this runtime check is
# available to --sdnotify=healthy.
# OpenCode v2: /api/info is the readiness endpoint (GET /global/health is now
# only the SPA catch-all and answers 200 for any path). curl without -f exits
# 0 on any HTTP response — 200 (auth ok) or 401 (API up behind auth) — and
# non-zero only when the server is not listening. No `%` (systemd specifier).
HealthCmd=curl -s -o /dev/null http://@@HOST@@:@@LISTEN_PORT@@/api/info
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=10s
HealthStartupCmd=curl -s -o /dev/null http://@@HOST@@:@@LISTEN_PORT@@/api/info
HealthStartupInterval=1s
HealthStartupTimeout=2s
HealthStartupRetries=0
HealthStartupSuccess=1

# The entrypoint runs as root for volume housekeeping,
# then drops to the agent user via setpriv.

# ---------- Bind mounts ----------

# Project directories (read-write, identity mounts: host path == container
# path, SELinux relabel). Identity mounts keep OpenCode session `directory`
# identities canonical across host clients and the attached TUI.
@@VOLUME_LINES@@

# contain generated policy (v2 sandbox policies, read-only)
Volume=@@CONTAINERD_CONFIG@@/opencode.json:/etc/contain/opencode.json:ro

# contain configuration (for opencode-tui wrapper)
Volume=@@CONTAINERD_CONFIG@@/config.json:/etc/contain/config.json:ro

# OpenCode global configuration (read-write; OpenCode persists provider
# registration and helper files here; the sandbox policy is layered on top
# via OPENCODE_CONFIG below).
Volume=@@PRIMARY_HOME@@/.config/opencode:/home/agent/.config/opencode:rw

# OpenCode data directory (read-write) — database, auth, logs, snapshots, etc.
Volume=@@PRIMARY_HOME@@/.local/share/opencode:/home/agent/.local/share/opencode:rw

# OpenCode state directory (read-write) — model preferences, prompt history, etc.
Volume=@@PRIMARY_HOME@@/.local/state/opencode:/home/agent/.local/state/opencode:rw

# ---------- Environment ----------
# OpenCode v2 always requires a server password. setup.sh generates a stable
# one once (root, 0600) if this file is absent; the in-container opencode-tui
# wrapper maps OPENCODE_SERVER_PASSWORD -> OPENCODE_PASSWORD for the client.
EnvironmentFile=/var/lib/contain/server-password

# Point opencode at the contain policy file (higher precedence than global config).
Environment=OPENCODE_CONFIG=/etc/contain/opencode.json

# ---------- Networking ----------
# Host networking keeps things simple; opencode binds to localhost only.
Network=host

# ---------- Resource limits ----------
PodmanArgs=--memory 2g --pids-limit 100

# ---------- Entrypoint args ----------
# Run OpenCode in server mode (headless HTTP server)
Exec=serve --hostname @@HOST@@ --port @@LISTEN_PORT@@

[Service]
Restart=on-failure
# OpenCode v2's Effect runtime exits 130 on both SIGTERM and SIGINT.
SuccessExitStatus=130
@@INSTALL_SECTION@@
